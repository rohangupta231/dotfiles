#!/usr/bin/env python3
"""cs2-wayland — toggle native Wayland for Counter-Strike 2.

Adds or removes `SDL_VIDEO_DRIVER=wayland` (CS2 bundles SDL3) in CS2's Steam
launch options, stored in ~/.steam/steam/userdata/*/config/localconfig.vdf.
Any other launch options are left as they are.

Steam rewrites localconfig.vdf on exit, so if Steam is running it is shut
down first and started again afterwards. Refuses to run while CS2 is open.

Usage: cs2-wayland [on|off|toggle|status]   (default: toggle)
"""
import glob
import os
import re
import shutil
import subprocess
import sys
import time

APP_ID = "730"
FLAG = "SDL_VIDEO_DRIVER=wayland"
DEFAULT_ON = f"{FLAG} %command% -fullscreen +fps_max 0"
CONFIGS = glob.glob(os.path.expanduser("~/.steam/steam/userdata/*/config/localconfig.vdf"))


def running(name):
    return subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0


def find_launch_line(lines):
    """Locate CS2's per-app block (the "730" block that tracks LastPlayed/LaunchOptions).

    Returns (LaunchOptions line index or None, block's closing-brace index, block indent).
    """
    for i, line in enumerate(lines):
        if line.strip() != f'"{APP_ID}"' or i + 1 >= len(lines) or lines[i + 1].strip() != "{":
            continue
        depth, launch, is_app = 0, None, False
        for j in range(i + 1, len(lines)):
            s = lines[j].strip()
            if s == "{":
                depth += 1
            elif s == "}":
                depth -= 1
                if depth == 0:
                    break
            elif depth == 1 and s.startswith('"LaunchOptions"'):
                launch, is_app = j, True
            elif depth == 1 and s.startswith('"LastPlayed"'):
                is_app = True
        if is_app:
            return launch, j, line[: len(line) - len(line.lstrip())]
    raise SystemExit(f"CS2 (app {APP_ID}) not found in localconfig.vdf")


def get_opts(path):
    lines = open(path, encoding="utf-8").read().split("\n")
    idx, _, _ = find_launch_line(lines)
    if idx is None:
        return ""
    m = re.match(r'\s*"LaunchOptions"\s+"(.*)"\s*$', lines[idx])
    return m.group(1).replace('\\"', '"').replace("\\\\", "\\") if m else ""


def set_opts(path, value):
    lines = open(path, encoding="utf-8").read().split("\n")
    idx, close, indent = find_launch_line(lines)
    esc = value.replace("\\", "\\\\").replace('"', '\\"')
    new = f'{indent}\t"LaunchOptions"\t\t"{esc}"'
    if idx is None:
        lines.insert(close, new)
    else:
        lines[idx] = new
    shutil.copy2(path, path + ".bak")
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


def enable(opts):
    if FLAG in opts:
        return opts
    if not opts.strip():
        return DEFAULT_ON
    if "%command%" in opts:
        return opts.replace("%command%", f"{FLAG} %command%", 1)
    return f"{FLAG} %command% {opts}"


def disable(opts):
    return re.sub(rf"\s*{re.escape(FLAG)}\s*", " ", opts).strip()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if cmd not in ("on", "off", "toggle", "status"):
        sys.exit(__doc__.strip().splitlines()[-1])
    if not CONFIGS:
        sys.exit("No Steam localconfig.vdf found")

    current = get_opts(CONFIGS[0])
    if cmd == "status":
        print(f"Wayland: {'on' if FLAG in current else 'off'}")
        print(f"Launch options: {current or '(none)'}")
        return

    want_on = {"on": True, "off": False, "toggle": FLAG not in current}[cmd]
    if running("cs2"):
        sys.exit("CS2 is running — quit it first")

    steam_was_running = running("steam")
    if steam_was_running:
        print("Closing Steam so it doesn't overwrite the change...")
        subprocess.run(["steam", "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(60):
            if not running("steam"):
                break
            time.sleep(0.5)
        else:
            sys.exit("Steam didn't exit within 30s — nothing changed")
        time.sleep(1)

    for path in CONFIGS:
        opts = get_opts(path)
        set_opts(path, enable(opts) if want_on else disable(opts))

    print(f"Wayland: {'on' if want_on else 'off'}")
    print(f"Launch options: {get_opts(CONFIGS[0]) or '(none)'}")

    if steam_was_running:
        print("Restarting Steam...")
        subprocess.Popen(["steam"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


if __name__ == "__main__":
    main()
